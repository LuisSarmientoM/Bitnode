{
  "name": "bitnode",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run build:web && npm start",
    "start": "tsx apps/server/src/main.ts",
    "db:init": "tsx scripts/db-init.ts",
    "auth:setup": "tsx apps/cli/src/auth.ts setup",
    "auth:reset": "tsx apps/cli/src/auth.ts reset",
    "tls:setup": "tsx apps/cli/src/tls.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "ng build web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test packages/core/test/*.test.ts packages/db/test/*.test.ts apps/server/test/*.test.ts apps/web/test/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "marked": "18.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
